generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Agency {
  id         String     @id @default(cuid())
  name       String
  email      String?
  phone      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  
  properties Property[]
  tenants    Tenant[]
  artisans   Artisan[]
  tickets    Ticket[]
}

model Property {
  id          String   @id @default(cuid())
  agencyId    String
  address     String
  city        String
  postalCode  String
  reference   String?
  token       String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tenants     Tenant[]
  tickets     Ticket[]
  
  @@index([agencyId])
  @@index([token])
}

model Tenant {
  id          String   @id @default(cuid())
  agencyId    String
  propertyId  String
  firstName   String
  lastName    String
  email       String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tickets     Ticket[]
  
  @@index([agencyId])
  @@index([propertyId])
}

model Artisan {
  id          String   @id @default(cuid())
  agencyId    String
  name        String
  specialty   String?
  email       String?
  phone       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  agency      Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tickets     Ticket[]
  
  @@index([agencyId])
}

model Ticket {
  id          String          @id @default(cuid())
  agencyId    String
  propertyId  String
  tenantId    String?
  artisanId   String?
  type        String
  description String
  urgency     String
  status      String          @default("nouveau")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  agency      Agency          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  property    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  artisan     Artisan?        @relation(fields: [artisanId], references: [id], onDelete: SetNull)
  photos      TicketPhoto[]
  timeline    TicketTimeline[]
  
  @@index([agencyId])
  @@index([propertyId])
  @@index([status])
}

model TicketPhoto {
  id        String   @id @default(cuid())
  ticketId  String
  filename  String
  createdAt DateTime @default(now())
  
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  @@index([ticketId])
}

model TicketTimeline {
  id        String   @id @default(cuid())
  ticketId  String
  status    String
  note      String?
  createdAt DateTime @default(now())
  
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  @@index([ticketId])
}
